# --- Required ---
TINYFISH_API_KEY=            # from https://agent.tinyfish.ai (each team member signs up via the event link)
ANTHROPIC_API_KEY=           # for news classification + narrative
DATABASE_URL=postgres://user:pass@localhost:5432/trustlens   # Neon or local Postgres

# --- Behaviour ---
DEMO_MODE=false              # true = serve fixtures as clearly-labelled replay data
ALLOW_SIMULATION=false       # allow /api/demo/simulate-change even when DEMO_MODE=false
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=              # alternative to Anthropic for news classification + narrative
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=                # anthropic | openai; empty = Anthropic if its key is set, else OpenAI
APP_BASE_URL=http://localhost:3000

# --- Orchestration ---
MAX_PARALLEL_ADAPTERS=6
ADAPTER_TIMEOUT_MS=90000
CASE_TIMEOUT_MS=180000
SOURCE_CACHE_TTL_SECONDS=600

# --- Monitoring ---
CRON_SECRET=change-me        # bearer secret for POST /api/cron/monitor
ENABLE_INPROCESS_SCHEDULER=true

# --- Optional ---
SLACK_WEBHOOK_URL=           # alert delivery (stretch)
